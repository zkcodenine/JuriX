# ══════════════════════════════════════════════════════════════════
#  JuriX — Ambiente de PRODUÇÃO (HostGator)
#  Publicado em: https://nossosflows.com.br/jurix
#
#  Copie para backend/.env NO SERVIDOR e preencha. Nunca versione o
#  .env preenchido: ele tem a senha do banco e o segredo do JWT.
# ══════════════════════════════════════════════════════════════════

# ─── Banco MySQL (cPanel → MySQL Databases) ───────────────────────
# Dentro da própria HostGator, o host é localhost — mais rápido e não
# exige liberar IP em Remote MySQL.
DATABASE_URL=mysql://USUARIO_CPANEL_jurix:SENHA@localhost:3306/USUARIO_CPANEL_jurix

# ─── Servidor ─────────────────────────────────────────────────────
NODE_ENV=production
# O Passenger (cPanel → Setup Node.js App) ignora a porta e usa socket.
# Mantida para quando rodar em VPS/porta própria.
PORT=3001

# O app vive num SUBDIRETÓRIO do domínio. Precisa bater com o
# VITE_BASE_PATH do frontend (frontend/.env.web).
BASE_PATH=/jurix

# Serve o React buildado pelo próprio Node (sem Apache extra).
SERVE_FRONTEND=true

# FRONTEND_DIST NÃO precisa ser definido: o app.js da raiz já resolve o
# caminho absoluto de ../frontend/dist. Só preencha se tiver movido a
# pasta do React para outro lugar — e então use caminho ABSOLUTO, porque
# um caminho relativo seria lido a partir de backend/.
# FRONTEND_DIST=/home/USUARIO/jurix-app/frontend/dist

# Domínio público — usado no CORS.
FRONTEND_URL=https://nossosflows.com.br
# Outras origens aceitas, separadas por vírgula (www, domínio alternativo).
EXTRA_ORIGINS=https://www.nossosflows.com.br

# Atrás do Apache/Passenger/Cloudflare: 1 = confia no primeiro salto.
# Sem isto o rate limit trata todos os usuários como um só IP.
TRUST_PROXY=1

# ─── JWT ──────────────────────────────────────────────────────────
# Gere um valor novo e longo. NÃO reaproveite o de desenvolvimento:
# quem tiver o segredo antigo consegue forjar tokens.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=TROQUE_POR_UM_SEGREDO_LONGO_E_ALEATORIO
JWT_EXPIRES_IN=7d

# ─── Cota do plano gratuito ───────────────────────────────────────
LIMITE_PROCESSOS_GRATUITO=5

# ─── Redis (opcional — em branco usa cache em memória) ────────────
REDIS_URL=
REDIS_DISABLED=true

# ─── DataJud CNJ ──────────────────────────────────────────────────
DATAJUD_API_URL=https://api-publica.datajud.cnj.jus.br
DATAJUD_API_KEY=

# ─── Google Agenda (OAuth) ────────────────────────────────────────
# Cadastre ESTE redirect URI no Google Cloud Console, exatamente assim:
#   https://nossosflows.com.br/jurix/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://nossosflows.com.br/jurix/api/google/callback

# ─── Mercado Pago ─────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_LINK_MENSAL=

# ─── InfoSimples (consulta a tribunais) ───────────────────────────
INFOSIMPLES_TOKEN=

# ─── Armazenamento de arquivos ────────────────────────────────────
# Caminho absoluto FORA do public_html, senão os documentos dos
# clientes ficam acessíveis por URL direta.
STORAGE_PATH=/home/USUARIO_CPANEL/jurix-storage
MAX_FILE_SIZE_MB=50
LOG_PATH=/home/USUARIO_CPANEL/jurix-logs

# ─── Monitor de processos (minutos entre verificações) ────────────
MONITOR_INTERVAL_MINUTES=180
